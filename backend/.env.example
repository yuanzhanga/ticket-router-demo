APP_NAME=Ticket Router Demo
DATABASE_PATH=./tickets.db
FRONTEND_ORIGIN=http://localhost:5173

# JEV 官方 API。留空时使用本地 mock，便于先运行 Demo。
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=jev
JEV_TIMEOUT_SECONDS=30

# 可选的 OpenAI-compatible 普通大模型兜底。
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
